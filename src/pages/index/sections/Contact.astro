
<section class="contact-section" id="contact">
  <div class="contact-container">

    <div class="contact-heading">
      <span class="contact-label">
        <span>✧</span> LET'S CREATE SOMETHING TOGETHER
      </span>

      <h2>
        Have an idea in mind?
        <span>Let's bring it to life.</span>
      </h2>

      <p class="contact-description">
        Tell us about your project, and let's explore how we can
        turn your ideas into a creative digital experience.
      </p>
    </div>

    <form class="contact-form" action="mailto:hello@example.com" method="POST" enctype="text/plain">

      <div class="form-row">
        <div class="form-group">
          <label for="name">Your Name</label>
          <input
            type="text"
            id="name"
            name="Name"
            placeholder="Enter your name"
            required
          />
        </div>

        <div class="form-group">
          <label for="email">Email Address</label>
          <input
            type="email"
            id="email"
            name="Email"
            placeholder="Enter your email"
            required
          />
        </div>
      </div>

      <div class="form-group">
        <label for="project">Project Type</label>
        <select id="project" name="Project Type" required>
          <option value="" disabled selected>Select a project type</option>
          <option value="Website Development">Website Development</option>
          <option value="UI/UX Design">UI/UX Design</option>
          <option value="Graphic Design">Graphic Design</option>
          <option value="Other">Other</option>
        </select>
      </div>

      <div class="form-group">
        <label for="message">Tell Us About Your Project</label>
        <textarea
          id="message"
          name="Message"
          rows="5"
          placeholder="Share your ideas, goals, or project details..."
          required
        ></textarea>
      </div>

      <button type="submit" class="contact-button">
        Send Project Inquiry <span>↗</span>
      </button>

    </form>

    <div class="contact-note">
      <span class="contact-line"></span>
      TWO FRIENDS. ONE CREATIVE TEAM. ENDLESS POSSIBILITIES.
    </div>

  </div>
</section>
