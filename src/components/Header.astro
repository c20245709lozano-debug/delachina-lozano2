
---
import lightLogo from "../images/ck-logo-light.png";
import darkLogo from "../images/ck-logo-dark.png";
---

<header class="site-header">
  <div class="header-container">

 <a href="#hero" class="brand">
  <picture class="brand-picture">
    <source
      srcset={darkLogo.src}
      media="(prefers-color-scheme: dark)"
    />

    <img
      src={lightLogo.src}
      alt="CK Together logo"
      class="brand-logo"
    />
  </picture>

  <span class="brand-name">
    CK Together
    <span>Connect & Keep</span>
  </span>
</a>

    <!-- Navigation -->
   <nav class="navigation">
  <a href="#hero">Home</a>
  <a href="#about">Our Story</a>
  <a href="#services">Services</a>
  <a href="#process">Our Process</a>
  <a href="#contact">Contact</a>
</nav>

    <!-- Call to Action -->
    <a href="#contact" class="header-button">
      Get in Touch
      <span aria-hidden="true">↗</span>
    </a>

  </div>
</header>
